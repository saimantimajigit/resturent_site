{
  "name": "savore-connected-demo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/validate-deployment-env.mjs && next start",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "demo:prepare": "node scripts/prepare-client-demo.mjs",
    "demo:verify": "node scripts/verify-client-demo.mjs",
    "demo:smoke": "node scripts/smoke-client-demo.mjs",
    "demo:rotate-qr": "node scripts/rotate-demo-qr.mjs",
    "demo:qr:prepare": "node scripts/phase1262-demo-journey.mjs --prepare-only",
    "demo:journey": "node scripts/phase1262-demo-journey.mjs",
    "demo:start:prod": "node scripts/run-client-demo-prod.mjs",
    "demo:start": "node scripts/run-client-demo.mjs",
    "db:seed:client-demo": "tsx prisma/seed-client-demo.ts",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-orders.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:integration": "tsx scripts/phase101-integration.ts",
    "test:orders": "tsx scripts/phase111-integration.ts",
    "test:floor": "tsx scripts/phase112-integration.ts",
    "test:qr-dining": "tsx scripts/phase113-integration.ts",
    "test:admin": "tsx scripts/phase114-integration.ts",
    "test:phase12": "tsx scripts/phase121-integration.ts",
    "test:phase123": "tsx scripts/phase123-integration.ts",
    "validate:contracts": "python3 scripts/check_contracts.py"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^18.0.7",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
